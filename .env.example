# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_. Used by the seed script and server actions that need elevated rights.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- First admin (seed script reads these; a password change is forced on first login) ----------
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ---------- Website / admin origins ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret the CMS "Publish" button sends to /api/revalidate (use a long random string)
REVALIDATE_SECRET=

# ---------- FastAPI backend (vault, GitHub sync, PDFs, cron) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Dev only: preview the admin UI without Supabase. Ignored when NODE_ENV=production ----------
ADMIN_DEMO=0

# FastAPI service (server-side only). The vault UI calls it from server actions.
API_URL=http://localhost:8000
SITE_REVALIDATE_URL=
