# Supabase (service role key lives ONLY here — never in the browser or the Next.js client bundle)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on the legacy HS256 JWT secret. Leave empty to verify tokens through the project's JWKS.
SUPABASE_JWT_SECRET=

# 32 random bytes, base64.  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# LOSING THIS KEY MAKES EVERY STORED SECRET UNRECOVERABLE. Back it up in a password manager / KMS.
VAULT_KEY=

# Comma-separated browser origins allowed to call this API (admin + website)
ALLOWED_ORIGINS=http://localhost:3000

# GitHub fine-grained token with read-only "Contents" + "Metadata" (+ "Checks") on the repos you track
GITHUB_TOKEN=

# Shared secret that backup scripts send as the x-webhook-secret header
BACKUP_WEBHOOK_SECRET=

# Website revalidate hook (POST /site/revalidate forwards here)
SITE_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# Set to 0 to disable the built-in daily reminder job (e.g. when you run it from an external cron)
ENABLE_SCHEDULER=1
